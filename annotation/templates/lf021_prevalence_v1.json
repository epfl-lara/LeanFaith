  "display_payload_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "LF-021 blinded prevalence annotation display payload v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "opaque_item_token",
      "natural_language_statement",
      "lean_a",
      "lean_b",
      "permitted_context"
    ],
    "properties": {
      "opaque_item_token": {
        "type": "string",
        "minLength": 1,
        "description": "Opaque annotation UI token; never a frame, theorem, invocation, or generator identifier."
      },
      "natural_language_statement": {
        "type": "string",
        "minLength": 1,
        "description": "Trusted natural-language claim shown as reference assistance."
      },
      "lean_a": {
        "$ref": "#/$defs/lean_views",
        "description": "Registered reference statement A."
      },
      "lean_b": {
        "$ref": "#/$defs/lean_views",
        "description": "Candidate autoformalization statement B."
      },
      "permitted_context": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "minimal_import_text",
          "namespace_text",
          "local_notation_text",
          "required_type_information"
        ],
        "properties": {
          "minimal_import_text": {
            "type": "string"
          },
          "namespace_text": {
            "type": "string"
          },
          "local_notation_text": {
            "type": "string"
          },
          "required_type_information": {
            "type": "string"
          },
          "view_unavailable_notices": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "$defs": {
      "lean_views": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "headless",
          "signature_pp",
          "signature_explicit"
        ],
        "properties": {
          "headless": {
            "type": "string",
            "minLength": 1
          },
          "signature_pp": {
            "type": "string",
            "minLength": 1
          },
          "signature_explicit": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "response_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "LF-021 independent semantic annotation response v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "same_claim",
      "relation",
      "confidence",
      "rationale",
      "reference_issue"
    ],
    "properties": {
      "same_claim": {
        "type": "string",
        "enum": [
          "same_claim",
          "not_same_claim",
          "ambiguous",
          "cannot_assess_yet"
        ]
      },
      "relation": {
        "oneOf": [
          {
            "type": "string",
            "enum": [
              "equivalent",
              "A_stronger",
              "B_stronger",
              "incomparable",
              "unrelated",
              "ambiguous"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "confidence": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      },
      "rationale": {
        "type": "string"
      },
      "reference_issue": {
        "type": "string",
        "enum": [
          "none",
          "suspected",
          "definite"
        ]
      },
      "error_types": {
        "type": "array",
        "description": "Optional E01-E30 analysis metadata; never determines the semantic answer.",
        "items": {
          "type": "string",
          "pattern": "^E(0[1-9]|[12][0-9]|30)$"
        },
        "uniqueItems": true
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "same_claim": {
              "const": "same_claim"
            }
          },
          "required": [
            "same_claim"
          ]
        },
        "then": {
          "properties": {
            "relation": {
              "const": "equivalent"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "same_claim": {
              "const": "not_same_claim"
            }
          },
          "required": [
            "same_claim"
          ]
        },
        "then": {
          "properties": {
            "relation": {
              "type": "string",
              "enum": [
                "A_stronger",
                "B_stronger",
                "incomparable",
                "unrelated"
              ]
            },
            "rationale": {
              "type": "string",
              "pattern": ".*\\S.*"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "same_claim": {
              "const": "ambiguous"
            }
          },
          "required": [
            "same_claim"
          ]
        },
        "then": {
          "properties": {
            "relation": {
              "const": "ambiguous"
            },
            "rationale": {
              "type": "string",
              "pattern": ".*\\S.*"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "same_claim": {
              "const": "cannot_assess_yet"
            }
          },
          "required": [
            "same_claim"
          ]
        },
        "then": {
          "properties": {
            "relation": {
              "type": "null"
            },
            "rationale": {
              "type": "string",
              "pattern": ".*\\S.*"
            }
          }
        }
      }
    ]
  },
  "blinding": {
